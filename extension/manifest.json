{
  "manifest_version": 3,
  "name": "RelyLess",
  "short_name": "RelyLess",
  "version": "0.5.0",
  "description": "保留真实英文，只在需要时提供简短英文线索和局部中文说明。本地优先。",
  "minimum_chrome_version": "116",
  "icons": {"16":"icons/icon-16.png","32":"icons/icon-32.png","48":"icons/icon-48.png","128":"icons/icon-128.png"},
  "permissions": ["activeTab", "scripting", "storage", "nativeMessaging", "offscreen", "contextMenus", "tts", "webNavigation"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "web_accessible_resources": [{"resources":["icons/relyless.svg"],"matches":["http://*/*","https://*/*"],"use_dynamic_url":true}],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "ui/popup.html", "default_title": "RelyLess", "default_icon": {"16":"icons/icon-16.png","32":"icons/icon-32.png","48":"icons/icon-48.png"}},
  "options_page": "ui/options.html",
  "commands": {
    "toggle-reading": {"description": "开启或暂停当前网页的阅读辅助"}
  },
  "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'none'"}
}
